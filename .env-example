# Copy to .env at the repo root and fill in.  Read automatically by the
# publish scripts (node --env-file-if-exists=.env).

# GitHub token with repo scope (contents:write for Pages/branch pushes).
GITHUB_TOKEN_VAR=ghp_your_token_here

# Optional local AI review provider keys. Never commit real keys.
# Gemini is the default provider for tools/ai-review.mjs (local runs only).
# GEMINI_API_KEY=your_google_ai_studio_key
# OPENROUTER_API_KEY=sk-or-your_key_here

# Dev-mode: stable per-run id for the dev-build-<id> branch and baked URLs.
# Optional — defaults to '<current-branch>-<short-sha>' when unset.
# DEV_BUILD_ID=my-feature-1
dist
lib
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Coverage directory used by tools like istanbul
coverage
*.lcov

# temp files
**/draft/*
*~.*
*~*

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# analyze-c.mjs result cache (gcc -fanalyzer runs)
.analyzer-cache/

# compressed files
*.tgz
*.xpi
*.rar
*.zip

.env
/.treehouse

# Local plans repository (docs/local_plan) — drafts kept in their own git repo
docs/local_plan/

*.local.*
*.local

# windres output (installer/src/helper build artifact)
*.res

# Generated files — regenerated on demand, never committed:
#   - installer/src/_config.h + resources.h  <- generated by the installer
#     Makefile (node tools/publish/syncGeneratedFiles.mjs / installer/embed.mjs)
#     on every build; the installer hash covers their true sources
#     (config/installer.conf + installer/web/*) instead.
#   - core/chrome/utils/updater/updater-config.sys.mjs <- regenerated at
#     publish time by tools/publish/createZip.mjs; it ships inside utils.zip
#     and is added back to the utils zip/hash explicitly (gitignore keeps the
#     on-disk state deterministic between fresh clones and dev machines).
installer/src/_config.h
installer/src/resources.h
core/chrome/utils/updater/updater-config.sys.mjs

# Remote updater stylesheet — generated on disk only for the ?demo=1 preview;
# the publisher builds it in-memory (tools/publish/syncGeneratedFiles.mjs).
tools/publish/remote-ui/updater.css

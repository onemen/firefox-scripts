{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    // The picker's inline script carries JSDoc casts; without checkJs the
    // checker parses the JS but ignores every cast, so `pnpm build`
    // (`astro check && astro build`) can never go green.
    "checkJs": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@utils/*": ["./src/utils/*"]
    }
  }
}

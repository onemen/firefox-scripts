---
// A version picker for one release family (installer binaries or script
// zips): a dropdown of frozen tags, newest first, with the selected
// version's file links below it. The newest version's files link through
// the moving `latest` tag (tag/latest), older versions through their own
// frozen tag — so the newest entry is always the current build even when
// the generated release list is a fetch behind.
//
// Everything but the dropdown switching is prerendered: with JS disabled
// the newest version's files are simply shown.
interface VersionFile {
  name: string;
  label: string;
}
interface VersionAsset {
  name: string;
  href: string;
}
interface Version {
  tag: string;
  date: string;
  htmlUrl: string;
  assets: VersionAsset[];
}
interface Props {
  id: string;
  familyLabel: string;
  versions: Version[];
  files: VersionFile[];
  latestAssets: VersionAsset[];
}

const { id, familyLabel, versions, files, latestAssets } = Astro.props;
const selectId = `${id}-select`;
const latestByName = new Map(latestAssets.map((a) => [a.name, a.href]));

// `YYYY-MM-DD` → `September 26, 2026`. Built from parts, never parsed as a
// date string, so no timezone can shift it a day.
function longDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(y, m - 1, d).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

function optionLabel(version: Version, newest: boolean): string {
  return `${familyLabel} - ${longDate(version.date)}${newest ? ' — Latest' : ''}`;
}

// File href for one version: the `latest`-tag URL for the newest version of
// the family, that version's own frozen-tag URL otherwise. Null when the
// version never shipped the file (the link is then omitted, never dead).
function fileHref(version: Version, newest: boolean, name: string): string | null {
  const own = version.assets.find((a) => a.name === name)?.href ?? null;
  if (!newest) return own;
  return latestByName.get(name) ?? own;
}
---

{
  versions.length === 0 ? (
    <p>
      No frozen releases of this kind are listed. See the{' '}
      <a href="https://github.com/onemen/firefox-scripts/releases">releases page</a>{' '}
      directly.
    </p>
  ) : (
    <div class="release-downloads" data-release-downloads>
      <p class="picker-row">
        <label for={selectId}>Version</label>
        <select id={selectId} data-version-select>
          {versions.map((v, i) => (
            <option value={v.tag} selected={i === 0 ? true : undefined}>
              {optionLabel(v, i === 0)}
            </option>
          ))}
        </select>
      </p>
      {versions.map((v, i) => {
        const newest = i === 0;
        const links = files
          .map((f) => ({
            ...f,
            href: fileHref(v, newest, f.name),
            sha: fileHref(v, newest, `${f.name}.sha256`),
          }))
          .filter((f) => f.href !== null);
        return (
          <div data-version-files data-tag={v.tag} hidden={i === 0 ? undefined : true}>
            <p class="version-meta">
              Published {longDate(v.date)}
              {newest ? (
                <>
                  {' '}· newest build, served from{' '}
                  <a href="https://github.com/onemen/firefox-scripts/releases/tag/latest">
                    tag/latest
                  </a>
                </>
              ) : (
                <>
                  {' '}· <a href={v.htmlUrl}>release page</a>
                </>
              )}
            </p>
            <ul class="file-list">
              {links.map((f) => (
                <li>
                  <a href={f.href ?? ''}>
                    <code>{f.name}</code>
                  </a>{' '}
                  <span class="file-label">— {f.label}</span>
                  {f.sha !== null && (
                    <a class="sha-link" href={f.sha}>
                      sha256
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  )
}

<script>
  // One copy of this script lands per component instance; the guard keeps
  // the second copy from double-wiring the same dropdowns.
  document.querySelectorAll('select[data-version-select]').forEach((node) => {
    const sel = /** @type {HTMLSelectElement} */ (node);
    if (sel.dataset.wired) return;
    sel.dataset.wired = '1';
    const root = sel.closest('[data-release-downloads]');
    if (!root) return;
    sel.addEventListener('change', () => {
      root.querySelectorAll('[data-version-files]').forEach((el) => {
        const div = /** @type {HTMLElement} */ (el);
        div.hidden = div.dataset.tag !== sel.value;
      });
    });
  });
</script>

<style>
  .release-downloads {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-block: 1rem;
    background: var(--sl-color-gray-7, transparent);
  }
  .picker-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    line-height: 1.4;
  }
  .picker-row > * {
    margin: 0;
  }
  .picker-row label {
    font-weight: 600;
    flex: none;
    align-self: center;
  }
  .picker-row select {
    font: inherit;
    line-height: inherit;
    flex: 1;
    min-width: 0;
    align-self: center;
    padding: 0.45rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    vertical-align: middle;
  }
  .picker-row select:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }
  .version-meta {
    margin: 0 0 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
  }
  .file-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* One shared 3-column grid — identical fr widths in both cards, since
     both lists span the same content width. */
  .file-list li {
    display: grid;
    grid-template-columns: 1.2fr 1fr auto;
    column-gap: 1rem;
    align-items: baseline;
    padding: 0.4rem 0;
    border-top: 1px solid var(--sl-color-gray-6);
  }
  .file-list li:first-child {
    border-top: 0;
  }
  .file-list .file-label {
    color: var(--sl-color-gray-3);
  }
  .file-list .sha-link {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
    justify-self: end;
  }
  @media (max-width: 40rem) {
    .file-list li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .file-list .file-label {
      grid-column: 1 / -1;
    }
  }
</style>

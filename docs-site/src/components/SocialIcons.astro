---
// Header links, after the tabmixplus-docs pattern: Download lives in the
// top bar (next to the social icons), not in the sidebar — it is the one
// page every visitor needs within one click.
import { Icon } from '@astrojs/starlight/components';
import config from 'virtual:starlight/user-config';

const links = config.social || [];
---

<div class="header-links">
  <a href="/firefox-scripts/download/">
    <span>Download</span>
  </a>
</div>

{
  links.length > 0 && (
    <>
      {links.map(({ label, href, icon }) => (
        <a {href} rel="me" class="sl-flex">
          <span class="sr-only">{label}</span>
          <Icon name={icon} />
        </a>
      ))}
    </>
  )
}

<style>
  @layer starlight.core {
    .header-links {
      display: none;
    }
    @media (min-width: 72rem) {
      .header-links {
        display: flex;
        align-items: center;
      }
      .header-links a {
        color: var(--sl-color-text-accent);
        font-weight: 600;
        padding: 0.5em;
        margin: -0.5em;
        text-decoration: none;
      }
      .header-links a:hover {
        color: var(--sl-color-white);
      }
    }
  }
</style>

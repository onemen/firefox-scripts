{
  "name": "firefox_scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Scripts for installing legacy extension on Firefox",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@^12.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "pnpm run lint:js && pnpm run lint:ncpy && pnpm run lint:apt && pnpm run lint:types && pnpm run lint:c && pnpm run lint:analyze && pnpm run lint:md && pnpm run lint:md-markers && pnpm run lint:yaml && pnpm run lint:skills && pnpm run lint:skill-cmds",
    "lint:js": "eslint --config ./config/eslint.config.js --cache --cache-strategy content --cache-location ./config/.eslintcache --max-warnings 0",
    "lint:ncpy": "node tools/check-strncpy.mjs",
    "lint:apt": "node tools/check-apt-get.mjs",
    "lint:types": "tsc --project tsconfig.tools.json",
    "lint:c": "node tools/format-c.mjs --check",
    "lint:analyze": "make -C installer analyze",
    "lint:md": "markdownlint --config ./config/.markdownlint.jsonc --ignore-path ./config/.markdownlintignore --dot \"**/*.md\"",
    "lint:md-markers": "node tools/check-md-list-markers.mjs",
    "lint:yaml": "node tools/check-yaml-frontmatter.mjs",
    "lint:skills": "node tools/check-skills.mjs",
    "lint:skill-cmds": "node tools/check-skill-commands.mjs",
    "lint:all": "run-s --continue-on-error --print-label lint:js lint:ncpy lint:apt lint:types lint:c lint:analyze lint:md lint:md-markers lint:yaml lint:skills lint:skill-cmds",
    "hooks:install": "node tools/install-githooks.mjs",
    "format": "node tools/sync-skill-gates.mjs && node tools/format-c.mjs --check && prettier --config ./config/prettier.config.js --ignore-path ./config/.prettierignore . --check",
    "format:fix": "node tools/sync-skill-gates.mjs --fix && node tools/format-c.mjs --write && prettier --config ./config/prettier.config.js --ignore-path ./config/.prettierignore . --write",
    "test": "node --test \"test/unit/**/*.test.mjs\"",
    "check:decisions": "node tools/check-decisions.mjs",
    "check:skills-drift": "node tools/skills-watchdog.mjs --dry-run",
    "check:gates": "node tools/check-gate-coverage.mjs",
    "check:core-tests": "node tools/check-core-test-change.mjs",
    "test:hash": "node installer/test/test_hash.mjs && node installer/test/test_self_update.mjs",
    "toolchain:check": "node tools/ci/msys2Toolchain.mjs --check",
    "toolchain:local": "node tools/ci/msys2Toolchain.mjs --prefix",
    "scan:av": "node tools/scan-av.mjs",
    "scan:vt": "node --env-file-if-exists=.env tools/scan-vt.mjs",
    "test:e2e": "node test/e2e/shared/run.mjs",
    "test:e2e:installer": "node test/e2e/shared/run.mjs --installer",
    "test:e2e:updater": "node test/e2e/shared/run.mjs --updater",
    "test:e2e:legacy": "node test/e2e/core/manifest-lifecycle-e2e.mjs",
    "test:e2e:prepush": "node tools/e2e-prepush.mjs",
    "e2e:portable": "node tools/e2e-portable.mjs",
    "snapshot:prod": "node tools/publish/upload.mjs --local --mode=prod --include=all",
    "snapshot:dev": "node tools/publish/upload.mjs --local --mode=dev --include=all",
    "publish:dev": "node tools/publish/release.mjs --mode=dev --include=all",
    "publish:all": "node tools/publish/release.mjs --include=all",
    "publish:packages": "node tools/publish/release.mjs --include=packages",
    "publish:updater-ui": "node tools/publish/release.mjs --include=updater-ui",
    "publish:installer": "node tools/publish/release.mjs --include=installer",
    "publish:helper": "node tools/publish/release.mjs --include=helper",
    "release:stage": "node --env-file-if-exists=.env tools/publish/release.mjs --stage",
    "release:verify": "node tools/publish/releaseVerify.mjs",
    "fetch:release": "node tools/publish/fetchRelease.mjs",
    "dev-clean": "node --env-file-if-exists=.env tools/publish/devClean.mjs",
    "review:batch": "node tools/ci/batch-review.mjs",
    "ci:download": "node tools/ci/ciDownload.mjs",
    "ci:legs-table": "node tools/ci/e2eLegsTable.mjs",
    "review:local": "node tools/ai-review.mjs",
    "test:skills": "node tools/check-skills.mjs --skip-tests"
  },
  "keywords": [],
  "author": "ONEMEN <tabmix.onemen@gmail.com> (https://github.com/onemen)",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@microsoft/eslint-plugin-sdl": "1.1.0",
    "@octokit/rest": "22.0.1",
    "@types/node": "26.6.3",
    "archiver": "8.0.0",
    "clang-format": "1.8.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-mozilla": "5.0.1",
    "eslint-plugin-security": "4.1.0",
    "globals": "17.12.0",
    "js-yaml": "5.4.1",
    "markdownlint-cli": "0.49.1",
    "minimatch": "10.2.6",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.9",
    "prettier-plugin-jsdoc": "1.8.1",
    "puppeteer-core": "25.12.0",
    "typescript": "7.0.2"
  }
}

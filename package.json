{
  "name": "firefox_scripts",
  "version": "1.0.0",
  "description": "Scripts for installing legacy extension on Firefox",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm run lint:js && pnpm run lint:ncpy && pnpm run lint:types && pnpm run lint:c && pnpm run lint:analyze && pnpm run lint:md && pnpm run lint:skills",
    "lint:js": "eslint --config ./config/eslint.config.js --cache --cache-strategy content --cache-location ./config/.eslintcache --max-warnings 0",
    "lint:ncpy": "node tools/check-strncpy.mjs",
    "lint:types": "tsc --project tsconfig.tools.json",
    "lint:c": "node tools/format-c.mjs --check",
    "lint:analyze": "make -C installer analyze",
    "lint:md": "markdownlint-cli2 --config ./config/.markdownlint-cli2.jsonc \"**/*.md\" \"#node_modules\" \"#dist\"",
    "lint:skills": "node tools/check-skills.mjs",
    "lint:all": "run-s --continue-on-error --print-label lint:js lint:ncpy lint:types lint:c lint:analyze lint:md lint:skills",
    "hooks:install": "node tools/install-githooks.mjs",
    "format": "node tools/sync-skill-gates.mjs && node tools/format-c.mjs --check && prettier --config ./config/prettier.config.js --ignore-path ./config/.prettierignore . --check",
    "format:fix": "node tools/sync-skill-gates.mjs --fix && node tools/format-c.mjs --write && prettier --config ./config/prettier.config.js --ignore-path ./config/.prettierignore . --write",
    "test": "node --test \"test/unit/**/*.test.mjs\"",
    "check:decisions": "node tools/check-decisions.mjs",
    "check:gates": "node tools/check-gate-coverage.mjs",
    "test:hash": "node installer/test/test_hash.mjs && node installer/test/test_self_update.mjs",
    "toolchain:check": "node tools/ci/msys2Toolchain.mjs --check",
    "toolchain:local": "node tools/ci/msys2Toolchain.mjs --prefix",
    "scan:av": "node tools/scan-av.mjs",
    "scan:vt": "node --env-file-if-exists=.env tools/scan-vt.mjs",
    "test:e2e": "node test/e2e/shared/run.mjs",
    "test:e2e:installer": "node test/e2e/shared/run.mjs --installer",
    "test:e2e:updater": "node test/e2e/shared/run.mjs --updater",
    "test:e2e:legacy": "node test/e2e/core/manifest-lifecycle-e2e.mjs",
    "upload": "node --env-file-if-exists=.env tools/publish/upload.mjs",
    "release:all": "node tools/publish/release.mjs --include=all",
    "release:packages": "node tools/publish/release.mjs --include=packages",
    "release:installer": "node tools/publish/release.mjs --include=installer",
    "release:helper": "node tools/publish/release.mjs --include=helper",
    "upload:local": "node tools/publish/upload.mjs --local --include=all",
    "dev-clean": "node --env-file-if-exists=.env tools/publish/devClean.mjs",
    "review:batch": "node tools/ci/batch-review.mjs",
    "ci:download": "node tools/ci/ciDownload.mjs",
    "review:local": "node tools/ai-review.mjs",
    "test:skills": "node tools/check-skills.mjs --skip-tests"
  },
  "keywords": [],
  "author": "ONEMEN <tabmix.onemen@gmail.com> (https://github.com/onemen)",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@microsoft/eslint-plugin-sdl": "1.1.0",
    "@octokit/rest": "22.0.1",
    "@types/node": "24.13.4",
    "archiver": "8.0.0",
    "clang-format": "1.8.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-mozilla": "5.0.1",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.2",
    "minimatch": "10.2.6",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-jsdoc": "1.8.1",
    "puppeteer-core": "25.10.0",
    "typescript": "7.0.2"
  }
}

#include <windows.h>
#include "_builddate.h"

// Windows version resource for the installer executable.  The helper binary
// (src/helper/version.rc) already carries one; without it the installer is a
// stripped, unsigned PE with no metadata — the exact profile AV machine-learning
// engines flag as suspicious (Defender: Program:Script/Wacapew.A!ml).
// The repo ships unversioned date-stamped artifacts (ADR 0019): FileVersion
// carries the build date as 1,0,<YYYY>,<MMDD> and ProductVersion the date.
// The date itself is DERIVED (issue #322): _builddate.h is generated from the
// last commit touching this binary's inputs — CFG_BUILD_DATE_INSTALLER.

VS_VERSION_INFO VERSIONINFO
FILEVERSION     CFG_BUILD_DATE_INSTALLER_V
PRODUCTVERSION  CFG_BUILD_DATE_INSTALLER_V
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Comments",         "Installs and updates the Firefox Scripts helper packages (fx-folder + utils)\0"
            VALUE "CompanyName",      "Tab Mix Plus\0"
            VALUE "FileDescription",  "Firefox Scripts Installer\0"
            VALUE "FileVersion",      CFG_BUILD_DATE_INSTALLER_STR
            VALUE "InternalName",     "installer_win.exe\0"
            VALUE "LegalCopyright",   "Copyright 2026 Tab Mix Plus\0"
            VALUE "OriginalFilename", "installer_win.exe\0"
            VALUE "ProductName",      "Firefox Scripts\0"
            VALUE "ProductVersion",   CFG_BUILD_DATE_INSTALLER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application icon (resource id 1): the updater's own mark, rendered at each
// icon size by tools/make-installer-icon.mjs into the committed
// src/installer.ico (re-run that script when the artwork changes).  Without an
// icon resource Explorer and the taskbar show a blank-document glyph, and a
// stripped PE carrying neither icon nor metadata is part of the weak-signal
// profile AV machine learning scores — see docs/DEVELOPING.md → AV false
// positives.  The helper reuses the same file (src/helper/version.rc).
1 ICON "installer.ico"

// Application manifest: explicit asInvoker (no UAC prompt for the installer
// itself — the standalone helper elevates), DPI-aware, and Win10/11
// compatibility GUIDs.  A manifest is a standard legitimacy signal for
// non-elevating GUI tools.
1 RT_MANIFEST "installer.manifest"
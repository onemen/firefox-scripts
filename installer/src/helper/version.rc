// The repo ships unversioned date-stamped artifacts (ADR 0019); the helper's
// identity rides on the installer, which embeds it and verifies it by hash.
// FileVersion carries the build date as 1,0,<YYYY>,<MMDD>.  The date is
// DERIVED (issue #322): ../_builddate.h is generated from the last commit
// touching the helper's inputs — CFG_BUILD_DATE_HELPER.
#include <windows.h>
#include "../_builddate.h"

#define STR2(x) #x
#define STR(x) STR2(x)

VS_VERSION_INFO VERSIONINFO
FILEVERSION     CFG_BUILD_DATE_HELPER_V
PRODUCTVERSION  CFG_BUILD_DATE_HELPER_V
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Comments",         "Tab Mix Plus\0"
            VALUE "CompanyName",      "Tab Mix Plus\0"
            VALUE "FileDescription",  "Admin Copy Helper\0"
            VALUE "FileVersion",      CFG_BUILD_DATE_HELPER_STR
            VALUE "InternalName",     "helper_win.exe\0"
            VALUE "LegalCopyright",   "Copyright 2026 Tab Mix Plus\0"
            VALUE "OriginalFilename", "helper_win.exe\0"
            VALUE "ProductName",      "Admin Copy\0"
            VALUE "ProductVersion",   CFG_BUILD_DATE_HELPER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application icon: the installer's own icon resource (rendered per size from
// the updater logo by tools/make-installer-icon.mjs), reused here so both PEs
// the user ever sees carry the same mark.  See installer.rc for why the icon
// resource matters.
1 ICON "../installer.ico"

// Application manifest (helper.manifest), mirroring installer.rc: asInvoker —
// the helper self-elevates via ShellExecuteExW("runas") — plus the Win10/11
// compatibility GUIDs and DPI awareness.  Declared explicitly instead of
// relying on the mingw crt's auto-linked default-manifest.o, which the older
// crt package CI installs did not provide: the shipped helper then had a
// version resource and NO manifest, the unmanifested-exe profile Windows
// applies installer-detection/virtualization heuristics to.
1 RT_MANIFEST "helper.manifest"